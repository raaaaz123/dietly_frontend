API_URL=http://localhost:8000

# Admin credentials. The values below are DEVELOPMENT ONLY and are published in
# this repository — `app/lib/adminSecrets.ts` treats them as "unset" whenever
# NODE_ENV=production, so copying this file to a production environment
# unchanged locks the admin panel out (503) rather than leaving it open.
#
# ADMIN_API_KEY does double duty: it authenticates the server-side proxy to the
# backend, and it derives the HMAC key for the admin session cookie. Leaving it
# at the value below in production would mean anyone who has read this repo can
# forge an admin session, which is why it fails closed rather than defaulting.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_API_KEY=vital-admin-dev-key

# Firebase Web Config (same project as mobile app)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Search Console / Bing Webmaster verification. Not secret, but per-property:
# paste the token each console gives you and redeploy. Unset means no meta tag
# is emitted, which is the right default for local and preview builds.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# PostHog web analytics. Unset means posthog-js is never loaded and the site
# ships with no third-party script at all — so this is the switch, not just the
# credential. Reaches the browser via the `env` block in next.config.ts.
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
