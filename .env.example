API_URL=http://localhost:8000

# Admin credentials. The values below are DEVELOPMENT ONLY and are published in
# this repository — `app/lib/adminSecrets.ts` treats them as "unset" whenever
# NODE_ENV=production, so copying this file to a production environment
# unchanged locks the admin panel out (503) rather than leaving it open.
#
# ADMIN_API_KEY does double duty: it authenticates the server-side proxy to the
# backend, and it derives the HMAC key for the admin session cookie. Leaving it
# at the value below in production would mean anyone who has read this repo can
# forge an admin session, which is why it fails closed rather than defaulting.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_API_KEY=vital-admin-dev-key

# Firebase Web Config (same project as mobile app)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Search Console / Bing Webmaster verification. Not secret, but per-property:
# paste the token each console gives you and redeploy. Unset means no meta tag
# is emitted, which is the right default for local and preview builds.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# PostHog web analytics. Unset means posthog-js is never loaded and the site
# ships with no third-party script at all — so this is the switch, not just the
# credential. Reaches the browser via the `env` block in next.config.ts.
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Amazon Bedrock — Kimi K2.5, for the public /food-scanner tool.
#
# BEDROCK_API_KEY is the switch as well as the credential: unset means the
# scan route answers 503 and no model call is ever made, so local and preview
# builds spend nothing by default. Generate a long-term key in the Bedrock
# console under API keys.
#
# This calls Bedrock's OpenAI-compatible Chat Completions endpoint with a
# bearer token, so no AWS SDK and no SigV4 signing is involved.
#
# BEDROCK_REGION must be a region where the model is actually available:
# us-east-1, us-east-2, us-west-2, eu-north-1, eu-west-2, ap-south-1,
# ap-northeast-1, ap-southeast-2/3/4 or sa-east-1. Kimi K2.5 is IN-REGION
# ONLY — there is no geo or global inference profile — so this choice decides
# where the request is served. ap-south-1 (Mumbai) is worth considering given
# where the search demand in KEYWORD_PLAN.md comes from.
#
# Server-only. Never expose these through next.config.ts's `env` block, which
# would inline them into the client bundle.
BEDROCK_API_KEY=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL=moonshotai.kimi-k2.5
